<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.GestorRestaurante" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/primary_restaurant</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_restaurant</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>

        <item name="android:colorAccent">@color/accent_restaurant</item>
    </style>

    <style name="Theme.GestorRestaurante" parent="Base.Theme.GestorRestaurante" />

    <style name="Widget.GestorRestaurante" parent="Widget.Material3.Button" />
    <style name="Widget.GestorRestaurante.Button" parent="Widget.Material3.Button" />

    <style name="Widget.GestorRestaurante.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="Widget.GestorRestaurante.Button.Delete" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/bg_button_delete</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="Widget.GestorRestaurante.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/input_text</item>
        <item name="android:textColorHint">@color/input_hint</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <style name="Theme.GestorRestaurante.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_restaurant</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_restaurant</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

</resources>